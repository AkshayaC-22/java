        HashSet<Integer> set = new HashSet<>();

        for (int num : a) {
            set.add(num);
        }

        for (int num : b) {
            set.add(num);
        }

        ArrayList<Integer> result = new ArrayList<>();

        for (int num : set) {
            result.add(num);
        }

        return result;
    }
