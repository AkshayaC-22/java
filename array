16.Count the triplets

Input: arr[] = [1, 5, 3, 2]
Output: 2 
a+b=c


import java.util.HashSet;

class Solution {

    int countTriplet(int arr[]) {

        HashSet<Integer> nums = new HashSet<>();

        for (int num : arr) {
            nums.add(num);
        }

        HashSet<String> triplets = new HashSet<>();

        for (int i = 0; i < arr.length; i++) {

            for (int j = i + 1; j < arr.length; j++) {

                int sum = arr[i] + arr[j];

                if (nums.contains(sum)) {

                    int a = Math.min(arr[i], arr[j]);
                    int b = Math.max(arr[i], arr[j]);

                    String key = a + "," + b + "," + sum;

                    triplets.add(key);
                }
            }
        }

        return triplets.size();
    }
}

17.Union of Arrays with Duplicates

Input: a[] = [1, 2, 3, 2, 1], b[] = [3, 2, 2, 3, 3, 2]
Output: [1, 2, 3]

import java.util.ArrayList;
import java.util.HashSet;

class Solution {

    public ArrayList<Integer> findUnion(int a[], int b[]) {

        HashSet<Integer> set = new HashSet<>();

        for (int num : a) {
            set.add(num);
        }

        for (int num : b) {
            set.add(num);
        }

        ArrayList<Integer> result = new ArrayList<>();

        for (int num : set) {
            result.add(num);
        }

        return result;
    }
}

18.Intersection of Arrays with Distinct


Input: a[] = [89, 24, 75, 11, 23], b[] = [89, 2, 4]
Output: 1


import java.util.HashSet;

class Solution {

    public static int intersectSize(int a[], int b[]) {

        HashSet<Integer> set = new HashSet<>();

        // Store all elements of a
        for (int num : a) {
            set.add(num);
        }

        int count = 0;

        // Check common elements
        for (int num : b) {

            if (set.contains(num)) {
                count++;
            }
        }

        return count;
    }
}


19.Remove Duplicates Sorted Array

Input: arr[] = [2, 2, 2, 2, 2]
Output: [2]

Input: arr[] = [1, 2, 4]
Output: [1, 2, 4]

import java.util.ArrayList;

class Solution {

    ArrayList<Integer> removeDuplicates(int[] arr) {

        ArrayList<Integer> result = new ArrayList<>();

        result.add(arr[0]); // first element add

        for (int i = 1; i < arr.length; i++) {

            if (arr[i] != arr[i - 1]) {
                result.add(arr[i]);
            }
        }

        return result;
    }
}


