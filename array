5.Missing in Array

Input: arr[] = [1, 2, 3, 5]
Output: 4

class Solution {
    int missingNum(int arr[]) {

        int n = arr.length + 1;

        long total = (long) n * (n + 1) / 2;

        long sum = 0;

        for (int num : arr) {
            sum += num;
        }

        return (int)(total - sum);
    }
}

