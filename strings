2.Count Group Occurrences

Input: s = "abc", k = 1
Output: 3

import java.util.HashMap;

class Solution {

    int countGroupOccurrences(String s, int k) {

        HashMap<Character, Integer> map = new HashMap<>();

        for (int i = 0; i < s.length(); i++) {

            // Count only the start of a new group
            if (i == 0 || s.charAt(i) != s.charAt(i - 1)) {

                char ch = s.charAt(i);

                map.put(ch, map.getOrDefault(ch, 0) + 1);
            }
        }

        int count = 0;

        for (int value : map.values()) {

            if (value == k) {
                count++;
            }
        }

        return count;
    }


3. Valid Anagram

Example 1:

Input: s = "anagram", t = "nagaram"

Output: true

Example 2:

Input: s = "rat", t = "car"

Output: false


import java.util.HashMap;

class Solution {

    public boolean isAnagram(String s, String t) {

        if (s.length() != t.length()) {
            return false;
        }

        HashMap<Character, Integer> map = new HashMap<>();

        // Count frequency of s
        for (char ch : s.toCharArray()) {

            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }

        // Reduce frequency using t
        for (char ch : t.toCharArray()) {

            if (!map.containsKey(ch) || map.get(ch) == 0) {
                return false;
            }

            map.put(ch, map.get(ch) - 1);
        }

        return true;
    }
}


4.Palindrome String


class Solution {

    boolean isPalindrome(String s) {

        int left = 0;
        int right = s.length() - 1;

        while (left < right) {

            if (s.charAt(left) != s.charAt(right)) {
                return false;
            }

            left++;
            right--;
        }

        return true;
    }
}



5.Reverse String

Input: s = ["h","e","l","l","o"]
Output: ["o","l","l","e","h"]

class Solution {

    public void reverseString(char[] s) {

        int left = 0;
        int right = s.length - 1;

        while (left < right) {

            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;

            left++;
            right--;
        }
    }
}


